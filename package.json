{
  "name": "calendar-monorepo",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "bun run --cwd apps/api dev & bun run --cwd apps/web dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api dev",
    "build": "bun run --cwd apps/web build",
    "start": "./start.sh",
    "check": "bun run --cwd apps/web check",
    "typecheck": "bun run --cwd apps/api typecheck",
    "db:push": "bun run --cwd apps/api db:push",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:studio": "bun run --cwd apps/api db:studio"
  }
}
